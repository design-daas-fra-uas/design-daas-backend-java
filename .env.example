DB_URL=jdbc:mariadb://localhost:3306/design_backend
DB_USERNAME=design
DB_PASSWORD=design_password
OAUTH_KEYS_DIR=./keys
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
MAIL_ENABLED=false
# Gmail SMTP example (requires a Google Account App Password, not your normal password):
# MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<your-account>@gmail.com
# MAIL_PASSWORD=<16-char Google App Password>
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=<your-account>@gmail.com
FRONTEND_URL=http://localhost:3000
